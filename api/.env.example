FIREBASE_AUTH_PROJECT_ID=teacherassist-514007
# Application Default Credentials または GOOGLE_APPLICATION_CREDENTIALS を使用
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/teacherassist-service-account.json
# システム管理者のGoogleメールアドレス
system_administrator=admin@example.com
FIRESTORE_DATABASE_ID=teacher-assist
# APIキーを暗号化して保存するためのFernetキー（本番ではSecret Manager等から設定）
# API_KEY_ENCRYPTION_KEY=
# Takane利用時は契約先のHTTPS chat/completions URLを設定
# TAKANE_CHAT_COMPLETIONS_URL=
